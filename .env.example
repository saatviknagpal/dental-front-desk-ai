# LLM provider: openai | anthropic | gemini | deepseek | custom (any OpenAI-compatible endpoint)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
# Defaults: gpt-4.1-mini | claude-sonnet-5-5 | gemini-3.6-flash | deepseek-chat
LLM_MODEL=
# Optional second model tried if the primary fails (same provider)
LLM_FALLBACK_MODEL=
# Only for LLM_PROVIDER=custom
LLM_BASE_URL=

# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> "Session pooler").
# Leave empty to use an in-process Postgres (PGlite) for local dev.
DATABASE_URL=
# Optional: persist the local PGlite DB to a folder instead of memory
PGLITE_DIR=

PRACTICE_TIMEZONE=America/Los_Angeles

# Eval judge (a different model family than the bot, to avoid self-bias). Free key: https://aistudio.google.com/apikey
EVAL_JUDGE_PROVIDER=gemini
GEMINI_API_KEY=

# Optional: Slack/Discord/any webhook that receives staff alerts (emergencies, handoffs)
STAFF_WEBHOOK_URL=

# Password for /staff, /evals and the staff APIs (browser login prompt, any username).
# Required in production; optional in local dev.
STAFF_PASSWORD=

# Shows the "Reset demo data" button on /staff when true
ALLOW_DEMO_RESET=true
